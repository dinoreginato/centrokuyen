{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/version.json",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate"
      },
      "dest": "/version.json"
    },
    {
      "src": "/index.html",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate"
      },
      "dest": "/index.html"
    },
    { "handle": "filesystem" },
    {
      "src": "/.*",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate"
      },
      "dest": "/index.html"
    }
  ]
}
